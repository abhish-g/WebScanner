# ============================================================
# LLM PROVIDERS
# ============================================================
# Providers are tried in order: OpenRouter -> Groq -> Gemini.
# Each has an independent free-tier quota, so configuring more than
# one multiplies your effective daily capacity.

# --- Primary: OpenRouter ---
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Model IDs ending in ":free" cost nothing. Anything else is billed.
# Check current free models at https://openrouter.ai/models?max_price=0
OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324:free

# --- Fallback 1: Groq ---
# https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Fallback 2: Google Gemini ---
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ============================================================
# APP
# ============================================================

APP_URL=http://localhost:7860
PORT=7860